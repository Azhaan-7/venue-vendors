# Required: enter your existing Azure SQL connection values through the host's secret settings.
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
# Generate a random secret of at least 32 bytes; use the same secret in both backends.
JWT_SECRET=
NODE_ENV=production
FRONTEND_ORIGINS=
# Optional. Defaults shown below are application limits, not credentials.
JWT_EXPIRES_IN_SECONDS=900
COOKIE_SAME_SITE=lax
# Leave empty until the actual proxy chain and trusted IP ranges have been verified.
TRUSTED_PROXY_CIDRS=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=120
RATE_LIMIT_GLOBAL_MAX=600
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_ACCOUNT_MAX=10
AUTH_MAX_CONCURRENT=4
# PORT is injected by Render. Do not add DB synchronization or automatic migration flags.
